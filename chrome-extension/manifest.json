{
  "manifest_version": 3,
  "name": "IOC Capture — dhtn.dcs.vn → xabacha.com",
  "version": "3.0.0",
  "description": "Chuyển văn bản + file đính kèm từ dhtn.dcs.vn sang IOC xabacha.com",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mở IOC Capture",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://dhtn.dcs.vn/*"],
      "js": [
        "config.js",
        "modules/dedup-manager.js",
        "modules/attachment-finder.js",
        "modules/pdf-downloader.js",
        "modules/state-machine.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://xabacha.com/*"],
      "js": ["xabacha-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["*://dhtn.dcs.vn/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": [
    "*://dhtn.dcs.vn/*",
    "*://xabacha.com/*"
  ]
}
