{
  "manifest_version": 3,
  "name": "IOC Capture — dhtn.dcs.vn → xabacha.com",
  "version": "2.0.0",
  "description": "Chuyển văn bản + file đính kèm từ dhtn.dcs.vn sang IOC xabacha.com tự động",
  "action": {
    "default_title": "Mở IOC Capture"
  },
  "content_scripts": [
    {
      "matches": ["*://dhtn.dcs.vn/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://dhtn.dcs.vn/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://xabacha.com/*"],
      "js": ["xabacha-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "*://dhtn.dcs.vn/*",
    "*://xabacha.com/*"
  ]
}
