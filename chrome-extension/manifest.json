{
  "manifest_version": 3,
  "name": "IOC Capture — dhtn.dcs.vn",
  "version": "1.0.0",
  "description": "Chuyển văn bản từ hệ thống dhtn.dcs.vn sang IOC xabacha.com chỉ bằng 1 click",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gửi văn bản sang IOC xabacha.com",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://dhtn.dcs.vn/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "*://dhtn.dcs.vn/*",
    "*://xabacha.com/*"
  ]
}
